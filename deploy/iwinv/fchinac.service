[Unit]
Description=fchinac Next.js application
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/fchinac/current
EnvironmentFile=/etc/fchinac/env
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/fchinac /var/lib/fchinac/uploads /var/log/fchinac
MemoryMax=1G

[Install]
WantedBy=multi-user.target
